# 提交时统一以 LF 入库，检出规则见下
* text=auto

# 源码 / 配置：检出为 LF（Rust、Tauri、Node 工具链均兼容）
*.rs             text eol=lf
*.toml           text eol=lf
*.json           text eol=lf
*.html           text eol=lf
*.css            text eol=lf
*.js             text eol=lf
*.md             text eol=lf
*.xml            text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.gitignore      text eol=lf
*.gitattributes  text eol=lf
LICENSE          text eol=lf

# Windows 脚本：检出为 CRLF
# 注意 scripts/make-msix.ps1 必须保留 UTF-8 BOM，否则 PowerShell 5.1 会按 GBK 解析中文注释导致语法错误
*.ps1            text eol=crlf
*.bat            text eol=crlf
*.cmd            text eol=crlf

# 二进制文件（禁止换行符转换与文本 diff）
*.png            binary
*.jpg            binary
*.jpeg           binary
*.ico            binary
*.icns           binary
*.exe            binary
*.dll            binary
*.msix           binary
*.msixbundle     binary
*.appx           binary
*.appxbundle     binary
*.appxupload     binary
*.pfx            binary
*.cer            binary
*.der            binary

# 生成文件：GitHub 语言统计与 diff 中标注
package-lock.json   linguist-generated=true diff
src-tauri/Cargo.lock linguist-generated=true diff

# 图标文件走 Git LFS（须置于上方 binary 规则之后，后匹配的规则按属性覆盖前者）
*.png  filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text
*.icns filter=lfs diff=lfs merge=lfs -text

