{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPAbuyer",
  "version": "2026.9.14",
  "identifier": "com.ipabuyer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IPAbuyer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ipatool"]
  }
}
